+    // Persistent record of loaded plugin packages, used by detectPlugins()
+    // to survive cold-boot PackageManager query misses. Lives in device
+    // protected storage alongside the rest of fcitx data.
+    private val knownPluginsFile = File(dataDir, "known-plugins.txt")
+
+    private fun loadKnownPlugins(): Set<String> =
+        knownPluginsFile.takeIf { it.exists() }
+            ?.readLines()
+            ?.filter { it.isNotBlank() }
+            ?.toSet()
+            ?: emptySet()
+
+    private fun saveKnownPlugins(packages: Set<String>) {
+        if (packages.isEmpty()) {
+            knownPluginsFile.delete()
+        } else {
+            knownPluginsFile.writeText(packages.sorted().joinToString("\n"))
+        }
+    }
