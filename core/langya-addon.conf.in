[Addon]
Name=Langya
Name[zh_CN]=琅琊小篆
Category=InputMethod
Version=@PROJECT_VERSION@
Library=langya
Type=SharedLibrary
# 随 fcitx 启动加载（不惰性拉起）：
# 1) fcitx5-android 附加组件配置页在插件未加载时拿不到 cfg/desc，
#    会显示「可能在 fcitx 启动时处于禁用状态」（task-34 缺陷），
#    OnDemand=False 使插件启动即加载，配置页恒可用；
# 2) fcitx5 无 addon 加载超时/watchdog，构造耗时无超时风险；
# 3) 桌面安装侧与集成测试本就按 OnDemand=False 布置，行为一致。
OnDemand=False
Configurable=True

# punctuation：中文标点服务（zh_CN 映射与配对/多候选状态机，
# 与 fcitx5 拼音共用同一模块同一配置）
[Addon/Dependencies]
0=punctuation

# chttrans：简繁转换（OpenCC 后端）。引擎已声明依赖，由 fcitx5
# 按依赖序拉起。档位配置来源随平台：桌面系统级安装提供
# /etc/xdg/fcitx5/conf/chttrans.conf（港繁 s2hk）；用户级 xmake
# 安装提供 ~/.config/fcitx5/conf/chttrans.conf；Android 宿主无法
# 下发 PkgConfig 文件，走 OpenCC 默认档（标准繁体）
[Addon/OptionalDependencies]
0=chttrans
